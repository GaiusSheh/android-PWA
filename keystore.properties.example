# 复制为 keystore.properties（已被 .gitignore 忽略），填入真实值。
# storeFile 可以是绝对路径，或相对于工程根目录的路径。建议把 .jks 放在工程目录之外（例如 ~/keys/）。
#
# 也可以不建这个文件，改用环境变量（CI 用这种方式）：
#   WEBSHELL_KEYSTORE_FILE / WEBSHELL_KEYSTORE_PASSWORD / WEBSHELL_KEY_ALIAS / WEBSHELL_KEY_PASSWORD
storeFile=C:/Users/you/keys/webshell-release.jks
storePassword=change-me
keyAlias=webshell
keyPassword=change-me
